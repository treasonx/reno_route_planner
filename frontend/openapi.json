          "us50": {
            "$ref": "#/components/schemas/CorridorOut"
          }
        },
        "required": [
          "i80",
          "us50",
          "sr88"
        ],
        "title": "CorridorsOut",
        "type": "object"
      },
      "DayOut": {
        "properties": {
          "best_route": {
            "enum": [
              "i80",
              "us50",
              "sr88"
            ],
            "title": "Best Route",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "day": {
            "title": "Day",
            "type": "integer"
          },
          "dow": {
            "title": "Dow",
            "type": "string"
          },
          "low_confidence": {
            "title": "Low Confidence",
            "type": "boolean"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "routes": {
            "$ref": "#/components/schemas/DayRoutesOut"
          },
          "verdict": {
            "enum": [
              "GO",
              "CAUTION",
              "NO GO"
            ],
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "date",
          "dow",
          "day",
          "verdict",
          "best_route",
          "reasons",
          "low_confidence",
          "routes"
        ],
        "title": "DayOut",
        "type": "object"
      },
      "DayRoutesOut": {
        "description": "Best verdict each highway can achieve that day.",
        "properties": {
          "i80": {
            "enum": [
              "GO",
              "CAUTION",
              "NO GO"
            ],
            "title": "I80",
            "type": "string"
          },
          "sr88": {
            "enum": [
              "GO",
              "CAUTION",
              "NO GO"
            ],
            "title": "Sr88",
            "type": "string"
          },
          "us50": {
            "enum": [
              "GO",
              "CAUTION",
              "NO GO"
            ],
            "title": "Us50",
            "type": "string"
          }
        },
        "required": [
          "i80",
          "us50",
          "sr88"
        ],
        "title": "DayRoutesOut",
        "type": "object"
      },
      "Direction": {
        "enum": [
          "reno-sac",
          "sac-reno"
        ],
        "title": "Direction",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HeroOut": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "sub": {
            "title": "Sub",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "sub",
          "body"
        ],
        "title": "HeroOut",
        "type": "object"
      },
      "HourOut": {
        "properties": {
          "best": {
            "$ref": "#/components/schemas/BestOut"
          },
          "depart": {
            "format": "date-time",
            "title": "Depart",
            "type": "string"
          },
          "hero": {
            "$ref": "#/components/schemas/HeroOut"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "routes": {
            "$ref": "#/components/schemas/RoutesOut"
          }
        },
        "required": [
          "depart",
          "label",
          "best",
          "hero",
          "routes"
        ],
        "title": "HourOut",
        "type": "object"
      },
      "PlanResponse": {
        "properties": {
          "corridors": {
            "$ref": "#/components/schemas/CorridorsOut"
          },
          "days": {
            "items": {
              "$ref": "#/components/schemas/DayOut"
            },
            "title": "Days",
            "type": "array"
          },
          "direction": {
            "enum": [
              "reno-sac",
              "sac-reno"
            ],
            "title": "Direction",
            "type": "string"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "hours": {
            "items": {
              "$ref": "#/components/schemas/HourOut"
            },
            "title": "Hours",
            "type": "array"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "title": "Notes",
            "type": "array"
          },
          "snapshot_version": {
            "title": "Snapshot Version",
            "type": "integer"
          },
          "sources": {
            "additionalProperties": {
              "$ref": "#/components/schemas/SourceOut"
            },
            "title": "Sources",
            "type": "object"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          }
        },
        "required": [
          "generated_at",
          "snapshot_version",
          "direction",
          "corridors",
          "hours",
          "days",
          "sources",
          "stale",
          "notes"
        ],
        "title": "PlanResponse",
        "type": "object"
      },
      "RouteOut": {
        "properties": {
          "caption": {
            "title": "Caption",
            "type": "string"
          },
          "freezing_level_ft": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Freezing Level Ft"
          },
          "go_until": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Go Until"
          },
          "segments": {
            "items": {
              "enum": [
                "GO",
                "CAUTION",
                "NO GO"
              ],
              "type": "string"
            },
            "title": "Segments",
            "type": "array"
          },
          "summit_eta": {
            "format": "date-time",
            "title": "Summit Eta",
            "type": "string"
          },
          "verdict": {
            "enum": [
              "GO",
              "CAUTION",
              "NO GO"
            ],
            "title": "Verdict",
            "type": "string"
          },
          "weather": {
            "items": {
              "$ref": "#/components/schemas/StopWeatherOut"
            },
            "title": "Weather",
            "type": "array"
          }
        },
        "required": [
          "verdict",
          "caption",
          "summit_eta",
          "segments",
          "go_until",
          "weather",
          "freezing_level_ft"
        ],
        "title": "RouteOut",
        "type": "object"
      },
      "RoutesOut": {
        "properties": {
          "i80": {
            "$ref": "#/components/schemas/RouteOut"
          },
          "sr88": {
            "$ref": "#/components/schemas/RouteOut"
          },
          "us50": {
            "$ref": "#/components/schemas/RouteOut"
          }
        },
        "required": [
          "i80",
          "us50",
          "sr88"
        ],
        "title": "RoutesOut",
        "type": "object"
      },
      "SourceOut": {
        "properties": {
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "consecutive_failures": {
            "title": "Consecutive Failures",
            "type": "integer"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_success": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "configured",
          "ok",
          "last_success",
          "consecutive_failures",
          "last_error"
        ],
        "title": "SourceOut",
        "type": "object"
      },
      "StatusResponse": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "snapshot_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Version"
          },
          "sources": {
            "additionalProperties": {
              "$ref": "#/components/schemas/SourceOut"
            },
            "title": "Sources",
            "type": "object"
          }
        },
        "required": [
          "ok",
          "snapshot_version",
          "sources"
        ],
        "title": "StatusResponse",
        "type": "object"
      },
      "StopOut": {
        "properties": {
          "elevation_ft": {
            "title": "Elevation Ft",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_summit": {
            "title": "Is Summit",
            "type": "boolean"
          },
          "minutes": {
            "title": "Minutes",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "peak_label": {
            "title": "Peak Label",
            "type": "string"
          },
          "short_label": {
            "title": "Short Label",
            "type": "string"
          },
          "x": {
            "title": "X",
            "type": "number"
          },
          "y": {
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "x",
          "y",
          "elevation_ft",
          "peak_label",
          "short_label",
          "minutes",
          "is_summit"
        ],
        "title": "StopOut",
        "type": "object"
      },
      "StopWeatherOut": {
        "description": "Forecast at a stop when you pass it (ETA = departure + ``StopOut.minutes``).",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "snow_depth_in": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snow Depth In"
          },
          "snowfall_in_hr": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snowfall In Hr"
          },
          "temp_f": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temp F"
          }
        },
        "required": [
          "id",
          "temp_f",
          "snow_depth_in",
          "snowfall_in_hr"
        ],
        "title": "StopWeatherOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Pass Check",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Liveness only: a dead upstream must never restart-loop the container.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/plan": {
      "get": {
        "operationId": "plan_api_plan_get",
        "parameters": [
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Direction",
              "default": "reno-sac"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          },
          {
            "in": "header",
            "name": "if-none-match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "No data yet"
          }
        },
        "summary": "Plan"
      }
    },
    "/api/status": {
      "get": {
        "operationId": "status_api_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Status"
      }
    }
  }
}
