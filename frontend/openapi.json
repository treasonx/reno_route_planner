{
  "components": {
    "schemas": {
      "BestOut": {
        "properties": {
          "route": {
            "enum": [
              "i80",
              "us50",
              "sr88"
            ],
            "title": "Route",
            "type": "string"
          },
          "verdict": {
            "enum": [
              "GO",
              "CAUTION",
              "NO GO"
            ],
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "route",
          "verdict"
        ],
        "title": "BestOut",
        "type": "object"
      },
      "CorridorOut": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/StopOut"
            },
            "title": "Stops",
            "type": "array"
          },
          "summit": {
            "title": "Summit",
            "type": "string"
          },
          "towns": {
            "items": {
              "type": "string"
            },
            "title": "Towns",
            "type": "array"
          }
        },
        "required": [
          "name",
          "summit",
          "stops",
          "towns"
        ],
